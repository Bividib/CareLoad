# Server-side only. Leave blank while the foundation uses no live AI.
OPENAI_API_KEY=
# Low-latency structured extraction through the Responses API.
OPENAI_TEXT_MODEL=gpt-5-mini
# Speech-to-text through ElevenLabs. Keep this server-side only.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

DATABASE_URL=file:./dev.db
DEMO_AI_FALLBACK=true
DEMO_AI_TIMEOUT_MS=25000
DEMO_RESPONSE_DELAY_MS=10000
NEXT_PUBLIC_DEMO_MODE=true
