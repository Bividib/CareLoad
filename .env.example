# Server-side only. Leave blank while the foundation uses no live AI.
OPENAI_API_KEY=
# Configure an available text model when AI integration is implemented.
OPENAI_TEXT_MODEL=gpt-5
# Configure an available transcription model when voice is implemented.
OPENAI_TRANSCRIPTION_MODEL=

DATABASE_URL=file:./dev.db
DEMO_AI_FALLBACK=true
DEMO_RESPONSE_DELAY_MS=10000
NEXT_PUBLIC_DEMO_MODE=true
